# Variables de entorno del servicio. Copiar a .env y completar (sin committear valores reales).
SERVICE_NAME=accounts-service
SERVER_PORT=8080
# Base de datos JDBC (JPA/Hibernate)
DB_URL=jdbc:postgresql://localhost:5432/accounts_db
DB_USER=
DB_PASSWORD=
# Servicio externo de score crediticio
CREDIT_SCORE_URL=https://credit-score.internal
